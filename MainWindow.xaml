<Window x:Class="ApexTelemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ApexTelemetry.ViewModels"
        Title="Apex Telemetry Control Panel"
        Icon="pack://application:,,,/Assets/app_icon.ico" 
        SizeToContent="Height" 
        Width="440"
        WindowStartupLocation="CenterScreen">
    <!-- Window content -->
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="APEX TELEMETRY" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding RaceStatus}" FontSize="13" Foreground="#FF9900" FontWeight="SemiBold" Margin="0,0,0,16"/>
            
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speed:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentSpeed, StringFormat={}{0:N1} m/s}" Grid.Column="1" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Radar Altitude:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentAltitude, StringFormat={}{0:N0} m}" Grid.Column="1" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Overlay Button -->
            <Button Content="Toggle Transparent Overlay" Command="{Binding ToggleOverlayCommand}" Margin="0,16,0,0" Padding="8"/>

            <!-- Debug Expander Section (Auto-resizing window, no ScrollViewer) -->
            <Expander Header="Status.json Debug Telemetry &amp; Bitflags" IsExpanded="{Binding IsDebugExpanded}" Margin="0,12,0,0">
                <Border Background="#1E1E1E" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Position & Planetary Coordinates -->
                        <TextBlock Text="POSITION &amp; ENVIRONMENT" Foreground="#FF9900" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="Latitude:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.Latitude, StringFormat={}{0:F6}}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Longitude:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.Longitude, StringFormat={}{0:F6}}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Heading:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.Heading, StringFormat={}{0:F1}°}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Planet Radius:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.PlanetRadius, StringFormat={}{0:N0} m}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="#33FFFFFF" Margin="0,8"/>

                        <!-- Raw Bitfield Hex Headers -->
                        <TextBlock Text="BITMASK HEX" Foreground="#FF9900" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="Flags (Raw):" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.Flags, StringFormat=0x{0:X8}}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Flags2 (Raw):" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.Flags2, StringFormat=0x{0:X8}}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="#33FFFFFF" Margin="0,8"/>

                        <!-- Primary Flight & Systems Status -->
                        <TextBlock Text="FLIGHT / SHIP STATUS (FLAGS)" Foreground="#FF9900" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="Flight Assist Off:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.FlightAssistOff}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Ship / Vehicle Lights:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.LightsOn}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Night Vision:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.NightVision}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Shields Up:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.ShieldsUp}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Landing Gear Down:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.LandingGearDown}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Hardpoints Deployed:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.HardpointsDeployed}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Cargo Scoop Deployed:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.CargoScoopDeployed}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Supercruise / Glide:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.Supercruise}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Mass Locked:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.MassLocked}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Landed / Docked:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.IsLanded}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="#33FFFFFF" Margin="0,8"/>

                        <!-- Odyssey & Vehicle State Flags2 -->
                        <TextBlock Text="ODYSSEY &amp; VEHICLE STATE (FLAGS2)" Foreground="#FF9900" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="Glide Mode:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.GlideMode}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="On Foot:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.OnFoot}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="On Foot Planet:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.OnFootOnPlanet}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="In Taxi:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock Text="{Binding LatestStatus.InTaxi}" Foreground="#00FFCC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </Grid>
</Window>