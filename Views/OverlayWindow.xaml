<Window x:Class="ApexTelemetry.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apex Telemetry Overlay" 
        Height="220" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Border Background="#C8000000" CornerRadius="8" Padding="14" Margin="10" BorderBrush="#FF9900" BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="APEX TELEMETRY" Foreground="#FF9900" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="RACE OVERLAY" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Separator Background="#33FF9900" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding RaceStatus}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid Margin="0,2">
                <TextBlock Text="Speed:" Foreground="#AAAAAA" FontSize="11"/>
                <TextBlock Text="{Binding CurrentSpeed, StringFormat={}{0:N1} m/s}" Foreground="#00FFCC" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,2">
                <TextBlock Text="Radar Alt:" Foreground="#AAAAAA" FontSize="11"/>
                <TextBlock Text="{Binding CurrentAltitude, StringFormat={}{0:N0} m}" Foreground="#00FFCC" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#666666" FontSize="9" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>